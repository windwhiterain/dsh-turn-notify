+/** 从 user-questions 请求里拼接问题文本（header 作前缀，多题用「；」连接）。 */
+function extractAskUserText(questions: unknown): string {
+  if (!Array.isArray(questions)) return ''
+  const parts: string[] = []
+  for (const raw of questions) {
+    if (raw === null || typeof raw !== 'object') continue
+    const item = raw as { question?: unknown; header?: unknown }
+    const question = typeof item.question === 'string' ? item.question : ''
+    const header = typeof item.header === 'string' && item.header.length > 0 ? item.header + ': ' : ''
+    if (question.length === 0 && header.length === 0) continue
+    // 通知正文保持单行；header 本身可能是含换行的长文本，统一折叠
+    parts.push(header + question)
+  }
+  return parts.join('；').replace(/\s+/g, ' ').trim()
+}
